	partition asset_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "asset_performance.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"symbol", type text}, {"name", type text}, {"start", type date}, {"end", type date}, {"days", Int64.Type}, {"last_close", type number}, {"total_return_pct", type number}, {"ann_return_pct", type number}, {"ann_volatility_pct", type number}, {"return_vol_ratio", type number}, {"max_drawdown_pct", type number}, {"close_1y_ago", type number}, {"close_latest", type number}, {"change_1y_pct", type number}, {"latest_date", type date}}, "en-US")
				in
				    Typed
