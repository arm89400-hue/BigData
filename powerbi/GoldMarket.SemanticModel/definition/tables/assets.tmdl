table assets
	lineageTag: 5197e35d-da80-4273-ad17-be7dc08ecd09

	column symbol
		dataType: string
		lineageTag: 128182bd-f630-4d81-91dd-931c3186ff75
		summarizeBy: none
		sourceColumn: symbol

	column name_th
		dataType: string
		lineageTag: 5a746eea-eea0-4ef3-a949-79716163fe14
		summarizeBy: none
		sourceColumn: name_th

	column name_en
		dataType: string
		lineageTag: 527d745a-4c8d-403b-b40b-45277d142e6f
		summarizeBy: none
		sourceColumn: name_en

	column asset_class
		dataType: string
		lineageTag: a6002c79-890f-4ac7-9e4f-9dc8b68227ef
		summarizeBy: none
		sourceColumn: asset_class

	partition assets = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "assets.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"symbol", type text}, {"name_th", type text}, {"name_en", type text}, {"asset_class", type text}}, "en-US")
				in
				    Typed
