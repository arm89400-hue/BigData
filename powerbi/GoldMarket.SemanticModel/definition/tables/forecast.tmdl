table forecast
	lineageTag: 83ab1e54-5160-4bef-b0df-e8a052b8b240

	column symbol
		dataType: string
		lineageTag: f7779bc3-7bce-4103-acb6-0d276a71a052
		summarizeBy: none
		sourceColumn: symbol

	column target_month
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 0a9c4bb8-8671-4b7d-aacc-3a73e1f43a4a
		summarizeBy: none
		sourceColumn: target_month

	column predicted_pct
		dataType: double
		formatString: #,0.00
		lineageTag: daac55c4-e881-4321-9390-63ddc6c37b78
		summarizeBy: sum
		sourceColumn: predicted_pct

	partition forecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "forecast.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"symbol", type text}, {"target_month", type date}, {"predicted_pct", type number}}, "en-US")
				in
				    Typed
