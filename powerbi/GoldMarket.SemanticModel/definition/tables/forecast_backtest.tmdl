table forecast_backtest
	lineageTag: 636dd712-c539-42ee-a9cc-5b2c2b6d159b

	column symbol
		dataType: string
		lineageTag: c7156a78-0f11-454d-bb68-e4fd3feedceb
		summarizeBy: none
		sourceColumn: symbol

	column month
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 572378c2-938b-45ee-b5c0-d4f741d3dc9c
		summarizeBy: none
		sourceColumn: month

	column predicted_pct
		dataType: double
		formatString: #,0.00
		lineageTag: 166dced5-090d-4cda-b531-8f38b1c182b7
		summarizeBy: sum
		sourceColumn: predicted_pct

	column actual_pct
		dataType: double
		formatString: #,0.00
		lineageTag: 5a37bfa8-0649-4314-8137-b8684f571633
		summarizeBy: sum
		sourceColumn: actual_pct

	partition forecast_backtest = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "forecast_backtest.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"symbol", type text}, {"month", type date}, {"predicted_pct", type number}, {"actual_pct", type number}}, "en-US")
				in
				    Typed
