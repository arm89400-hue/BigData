table hourly_scale
	lineageTag: 26dbac4f-fe99-484e-b2bc-dadc5eb41458

	column symbol
		dataType: string
		lineageTag: 56cfc3a9-6327-42be-9602-7a80d6b9f8f7
		summarizeBy: none
		sourceColumn: symbol

	column bars
		dataType: int64
		formatString: #,0
		lineageTag: a97ac971-a411-4bbf-ac3b-93ca0dde2319
		summarizeBy: sum
		sourceColumn: bars

	column trades
		dataType: int64
		formatString: #,0
		lineageTag: e0f1ceca-adb6-4b12-8577-8ed58578202f
		summarizeBy: sum
		sourceColumn: trades

	column quote_volume
		dataType: double
		formatString: #,0.00
		lineageTag: 949e0426-3ef9-4d13-9719-212f2088c1b5
		summarizeBy: sum
		sourceColumn: quote_volume

	column quote_volume_bn
		dataType: double
		formatString: #,0.00
		lineageTag: 6d4821d8-fe85-4de6-891a-b61d64288263
		summarizeBy: sum
		sourceColumn: quote_volume_bn

	partition hourly_scale = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "hourly_scale.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"symbol", type text}, {"bars", Int64.Type}, {"trades", Int64.Type}, {"quote_volume", type number}, {"quote_volume_bn", type number}}, "en-US")
				in
				    Typed
